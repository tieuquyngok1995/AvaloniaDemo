<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
      xmlns:local="clr-namespace:AvaloniaDemo.Converters"
        x:Class="AvaloniaDemo.Views.MessageBoxView"
  xmlns:vm="clr-namespace:AvaloniaDemo.ViewModels"
        x:DataType="vm:MessageBoxViewModel"
        Width="400"
SizeToContent="Height"
  xmlns:converters="clr-namespace:AvaloniaDemo.Converters"
 CanResize="False"
        SystemDecorations="None"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Title="{Binding Title}">

  <Border Background="White"
          CornerRadius="12"
          BorderBrush="#CCC"
          BorderThickness="1"
          Padding="0">

  <Grid RowDefinitions="Auto, *, Auto" ColumnSpacing="12" >
    <Border Grid.Row="0"
            Background="#EEE"
            Padding="8"
            CornerRadius="6 0">
      <Grid ColumnSpacing="8" ColumnDefinitions="Auto, *">

        <!-- Icon nhỏ -->
        <PathIcon Grid.Column="0"
                  Width="20" Height="20"
                  VerticalAlignment="Center"
                  Data="{Binding MessageType, Converter={x:Static local:Converters.MessageTypeToIcon}}"
                  Foreground="{Binding MessageType, Converter={x:Static local:Converters.MessageTypeToColor}}" />

        <!-- Title -->
        <TextBlock Grid.Column="1"
                   Text="{Binding Title}"
                   FontSize="16"
                   FontWeight="Bold"
                   VerticalAlignment="Center"/>
      </Grid>
    </Border>
    
    <!-- Dòng 1: Icon + Message -->
    <Grid Grid.Row="1" ColumnDefinitions="0.3*, 0.7*" IsVisible="{Binding !ShowProcessing}"
               Margin=" 0 12 0 0">
      <!-- Icon -->
      <PathIcon Grid.Column="0"
                       Height="64" Width="64"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Data="{Binding MessageType, Converter={x:Static local:Converters.MessageTypeToIcon}}"
                       Foreground="{Binding MessageType, Converter={x:Static local:Converters.MessageTypeToColor}}" />

      <!-- Message text -->
      <TextBlock Grid.Column="1" Padding="12 0"
                 Text="{Binding Message}"
                 TextWrapping="Wrap"
                 VerticalAlignment="Center"
                 FontSize="16"/>
      
    </Grid>
    <StackPanel Grid.Row="1" IsVisible="{Binding ShowProcessing}"
               Margin=" 0 16 0 0">
      <ProgressBar Height="16"
                   IsIndeterminate="True"
                   Minimum="0" Maximum="100" />

      <TextBlock Text="{Binding Message}"
                 TextWrapping="Wrap"
                 HorizontalAlignment="Center" />
    </StackPanel>
    
    <!-- Dòng 2: Buttons -->
    <StackPanel Grid.Row="2" IsVisible="{Binding !ShowProcessing}"
               Orientation="Horizontal"
               HorizontalAlignment="Center"  Margin="12" Spacing="24">

      <!-- Yes/No buttons -->
      <Button Name="YesButton"
              Content="Yes"
              Command="{Binding YesCommand}"
              MinWidth="80"
              IsVisible="{Binding ShowYesNo}"/>

      <Button Name="NoButton"
              Content="No"
              Command="{Binding NoCommand}"
              MinWidth="80"
              IsVisible="{Binding ShowYesNo}"/>

      <!-- OK/Cancel buttons -->
      <Button Name="OKButton"
              Content="OK"
              Command="{Binding OKCommand}"
              MinWidth="80"
              IsVisible="{Binding !ShowYesNo}"/>
    </StackPanel>
    <StackPanel Grid.Row="2" IsVisible="{Binding ShowProcessing}"
               Orientation="Horizontal"
               HorizontalAlignment="Center"  Margin="12" Spacing="24">
      <Button Name="CancelButton"
        Content="Cancel"
        Command="{Binding CancelCommand}"
        MinWidth="80"/>
    </StackPanel>
  </Grid>


  </Border>
</Window>
